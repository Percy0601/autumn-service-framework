<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>autumn-spring-boot</artifactId>
        <groupId>xyz.we-win.autumn</groupId>
        <version>1.1.0-SNAPSHOT</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>autumn-spring-boot-starter</artifactId>
    <packaging>jar</packaging>

    <name>autumn-spring-boot-starter</name>
    <description>Spring Boot starter that pulls in Autumn RPC auto-configuration.</description>
    <url>https://github.com/Percy0601/autumn-service-framework</url>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
    </properties>

    <dependencies>
        <dependency>
            <groupId>xyz.we-win.autumn</groupId>
            <artifactId>autumn-spring-boot-autoconfigure</artifactId>
        </dependency>
        <!-- 业务工程只按 README 引这一个 starter 时，@Export / @Reference 的 JSR-269 处理器
             也必须随之出现在编译 classpath 上（JDK 23+ 需要 -proc:full 才会扫描 classpath 上的处理器）。
             处理器运行时加载的注解类由 autumn-api（经 autoconfigure → core 传递）提供，
             这里再补上 autumn-compiler 本体与 FreeMarker 模板引擎，
             业务工程就不用自己拼 annotationProcessorPaths 了。 -->
        <dependency>
            <groupId>xyz.we-win.autumn</groupId>
            <artifactId>autumn-compiler</artifactId>
        </dependency>
        <dependency>
            <groupId>org.freemarker</groupId>
            <artifactId>freemarker</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven-compiler-plugin.version}</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
