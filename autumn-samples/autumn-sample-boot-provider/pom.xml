<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>autumn-samples</artifactId>
        <groupId>xyz.we-win.autumn</groupId>
        <version>1.1.0-SNAPSHOT</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>autumn-sample-boot-provider</artifactId>
    <packaging>jar</packaging>

    <name>autumn-sample-boot-provider</name>
    <url>http://maven.apache.org</url>

    <!-- JDK 23+ 默认关闭注解处理：这里打开，javac 就会扫描 classpath 上
         starter 传递来的 autumn-compiler（以及 lombok），无需 annotationProcessorPaths。 -->
    <properties>
        <maven.compiler.proc>full</maven.compiler.proc>
    </properties>

    <!-- 只用 README 里那一个 starter 依赖：spring-boot / thrift / slf4j / logback /
         jakarta.annotation 都由 starter 传递进来，业务工程不需要再逐个声明。 -->
    <dependencies>
        <dependency>
            <groupId>xyz.we-win.autumn</groupId>
            <artifactId>autumn-spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>xyz.we-win.autumn</groupId>
            <artifactId>autumn-sample-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>
        <dependency>
            <groupId>xyz.we-win.autumn</groupId>
            <artifactId>autumn-sample-boot-native-hints</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>


    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- GraalVM native: mvn -Pnative native:compile (JDK 25 / GraalVM 25) -->
        <profile>
            <id>native</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.springframework.boot</groupId>
                        <artifactId>spring-boot-maven-plugin</artifactId>
                    </plugin>
                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                        <configuration>
                            <mainClass>xyz.wewin.autumn.sample.boot.provider.BootSampleBootstrap</mainClass>
                            <imageName>autumn-sample-boot-provider-native</imageName>
                            <buildArgs>
                                <buildArg>-H:+ReportExceptionStackTraces</buildArg>
                                <!-- 反射/资源/动态代理元数据全部由 autumn-compiler 在编译期生成到
                                     target/classes/META-INF/native-image/xyz.we-win.autumn/autumn-*-hints/，
                                     native-image 自动扫描 classpath 合并，无需 -H:*ConfigurationResources 手工加载 -->
                            </buildArgs>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
