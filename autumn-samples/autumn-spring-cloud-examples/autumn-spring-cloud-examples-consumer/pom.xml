<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>xyz.we-win.autumn</groupId>
        <artifactId>autumn-spring-cloud-examples</artifactId>
        <version>1.0.0-RELEASE</version>
    </parent>

    <artifactId>autumn-spring-cloud-examples-consumer</artifactId>
    <packaging>jar</packaging>

    <name>autumn-spring-cloud-examples-consumer</name>
    <description>Spring Cloud consumer：经 Consul 发现 + LoadBalancer 声明式调用 provider</description>

    <properties>
        <java.version>25</java.version>
        <start-class>xyz.wewin.autumn.springcloud.examples.consumer.ConsumerBootstrap</start-class>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <exclusions>
                <!-- 洁癖：排除 snakeyaml（不使用 YAML 配置） -->
                <exclusion>
                    <groupId>org.yaml</groupId>
                    <artifactId>snakeyaml</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- Consul 服务注册与发现 -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-consul-discovery</artifactId>
        </dependency>
        <!-- 微服务间调用（lb:// 负载均衡） -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-loadbalancer</artifactId>
        </dependency>
        <!-- 共享服务契约 -->
        <dependency>
            <groupId>xyz.we-win.autumn</groupId>
            <artifactId>autumn-spring-cloud-examples-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- WebClient 客户端（HttpExchange 声明式调用） -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-webflux</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.graalvm.buildtools</groupId>
                <artifactId>native-maven-plugin</artifactId>
                <configuration>
                    <imageName>${project.artifactId}</imageName>
                    <mainClass>${start-class}</mainClass>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
